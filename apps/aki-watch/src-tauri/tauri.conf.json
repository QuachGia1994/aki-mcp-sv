{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aki Watch",
  "version": "../package.json",
  "identifier": "com.phongqk.aki-watch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aki Watch — Postman Team Auto-Joiner",
        "width": 1080,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../package.json": "aki-watch-runtime/package.json",
      "../../../scripts/postman-pool-control.js": "aki-watch-runtime/scripts/postman-pool-control.js",
      "../../../scripts/postman-pool.js": "aki-watch-runtime/scripts/postman-pool.js",
      "../../../scripts/postman-pool-setup.js": "aki-watch-runtime/scripts/postman-pool-setup.js",
      "../../../scripts/postman-pool-join.py": "aki-watch-runtime/scripts/postman-pool-join.py",
      "../../../scripts/postman-pool-telegram.py": "aki-watch-runtime/scripts/postman-pool-telegram.py",
      "../../../scripts/userdata.js": "aki-watch-runtime/scripts/userdata.js"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
